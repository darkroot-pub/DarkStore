        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.token.email === 'davidstha900@gmail.com' && auth.token.email_verified === true) || (!data.exists() && newData.child('submittedBy').val() === auth.token.email && newData.child('status').val() === 'Pending' && root.child('submissionLocks').child(newData.child('packageName').val().toLowerCase().replace('.', '_')).val() === auth.token.email) || (data.exists() && newData.exists() && data.child('submittedBy').val() === auth.token.email && newData.child('status').val() === data.child('status').val()) || (data.exists() && !newData.exists() && data.child('submittedBy').val() === auth.token.email && data.child('status').val() === 'Pending'))",
