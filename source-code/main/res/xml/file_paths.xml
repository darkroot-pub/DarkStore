<?xml version="1.0" encoding="utf-8"?>
<!-- Only the APK folders the installer uses are shareable - never whole storage. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cache_apks" path="apks/"/>
    <cache-path name="cache_updates" path="updates/"/>
    <external-cache-path name="external_cache_apks" path="apks/"/>
    <external-cache-path name="external_cache_updates" path="updates/"/>
</paths>
